# Rust / Cargo. The workspace moves the target directory to the repo root, so it is ignored here
# rather than under src-tauri/.
/target/

# Tauri generates capability schemas on build.
/src-tauri/gen/schemas/

# `tauri icon` writes iOS and Android sets beside the desktop ones whether or not they are wanted,
# and this app ships neither platform. Ignored rather than deleted-and-forgotten, so regenerating
# the icons from source.svg does not put fifty mobile PNGs into a review.
/src-tauri/icons/android/
/src-tauri/icons/ios/

# Node
node_modules/
.pnpm-store/
*.log
npm-debug.log*
pnpm-debug.log*

# Build output
/dist/
dist-ssr/
*.local

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Playwright MCP session output
.playwright-mcp/
